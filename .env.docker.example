# Copy to .env.docker to configure the container. Only the rewards-farmer
# service loads this file; the host's .env is not used there, because its paths
# and its localhost Ollama address mean different things inside a container.
#
# Every line is optional. With nothing set the image uses QUERY_SOURCE=trends,
# which needs no account and no model and still completes the search tasks.

# QUERY_SOURCE=trends is the image default. Set llm to use a model instead.
# QUERY_SOURCE=llm

# Local OpenAI-compatible endpoint, for example Ollama on the host. Inside the
# container localhost is the container itself, so the host is reached through
# host.docker.internal (docker-compose.yml makes that name resolve on Linux).
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=gemma3:4b
# LOCAL_LLM_API_KEY=

# Or OpenRouter.
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_TITLE=rewards-farmer
# LLM_REQUEST_TIMEOUT_SECONDS=60
